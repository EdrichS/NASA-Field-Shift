# Copy to .env at the repo root and fill in. Never commit .env.
# Blank values fall back to the defaults in backend/app/config.py.

# NASA
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_MAP_KEY=

# Google Earth Engine
EE_PROJECT=

# xAI / Grok (XAI_BASE_URL defaults to https://api.x.ai/v1)
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL_DEV=
XAI_MODEL_DEMO=
# The model the app actually uses: the dev name while building, the demo name for recording
XAI_MODEL=

# Auth0 (backend validates tokens)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# TigerData
DATABASE_URL=

# Alert email over SMTP (Gmail: smtp.gmail.com, port 587, an App Password; Resend: smtp.resend.com,
# username "resend", password = API key). SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Browser push (generated in step 4.3; VAPID_SUBJECT is a mailto: contact)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Background alert check interval in hours (default 6)
ALERT_CHECK_INTERVAL_HOURS=

# App (FRONTEND_ORIGINS defaults to http://localhost:5173; comma-separate extra origins)
FRONTEND_ORIGINS=
