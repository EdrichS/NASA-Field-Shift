# Copy to frontend/.env.local. Public values only: anything here is visible in the browser.
# Never put the xAI key, FIRMS key, database URL or Earthdata password in the frontend.
# Empty = /api on the same origin (Vite forwards it to FastAPI; works through the tunnel)
VITE_API_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
